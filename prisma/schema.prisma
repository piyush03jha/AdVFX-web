generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================================================
 * USERS / ADMIN
 * ============================================================
 */

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

/**
 * ============================================================
 * CATALOG
 * ============================================================
 */

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status ProductStatus @default(DRAFT)

  /** Merchandising flags used by storefront queries. */
  isFeatured  Boolean @default(false)
  isTrending  Boolean @default(false)
  isBestseller Boolean @default(false)
  badge       String?

  /** Physical product specifications. */
  material    String?
  scale       String?
  dimensions  String?
  height      String?
  base        String?
  packaging   String?
  weight      String?

  /** Product quantity currently available for sale. */
  inventory ProductInventory?

  prices ProductPrice[]
  media  ProductMedia[]
  files  ProductFile[]
  tags   ProductTag[]

  createdById String?
  createdBy   User? @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User? @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([isBestseller])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductPrice {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  currency      String  @default("INR")
  amountMinor   Int
  compareAtMinor Int?
  isActive      Boolean  @default(true)
  startsAt      DateTime?
  endsAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive])
  @@index([currency])
}

model ProductInventory {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stock        Int @default(0)
  lowStockAt   Int @default(5)
  trackStock   Boolean @default(true)
  allowBackorder Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type      ProductMediaType
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, type, sortOrder])
}

enum ProductMediaType {
  IMAGE
  MODEL_PREVIEW
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

/**
 * ============================================================
 * PRODUCT FILES / 3D ASSET PROCESSING
 * ============================================================
 */

model ProductFile {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  originalName String
  storageKey   String
  storageUrl   String?

  format   ProductFileFormat
  fileType ProductFileType
  mimeType String?
  fileSize BigInt

  processingStatus ProcessingStatus @default(PENDING)
  processingError  String?

  imageWidth      Int?
  imageHeight     Int?
  imageChannels   Int?
  imageHasAlpha   Boolean?
  imageColorSpace String?

  convertedFromId String?
  convertedFrom   ProductFile? @relation("ConvertedFiles", fields: [convertedFromId], references: [id])
  convertedFiles  ProductFile[] @relation("ConvertedFiles")

  processingJobs ProductFileProcessingJob[]
  generatedByJob ProductFileProcessingJob? @relation("ProcessingJobOutput")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([format])
  @@index([processingStatus])
  @@index([convertedFromId])
}

model ProductFileProcessingJob {
  id String @id @default(cuid())

  productFileId String
  productFile   ProductFile @relation(fields: [productFileId], references: [id], onDelete: Cascade)

  status       ProcessingJobStatus @default(QUEUED)
  attempts     Int @default(0)
  maxAttempts  Int @default(3)
  errorMessage String?

  outputFileId String? @unique
  outputFile   ProductFile? @relation("ProcessingJobOutput", fields: [outputFileId], references: [id], onDelete: SetNull)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productFileId])
  @@index([status])
}

enum ProductFileType {
  MODEL
  IMAGE
  DOCUMENT
}

enum ProductFileFormat {
  ABC
  USD
  USDA
  USDC
  SVG
  PDF
  JPG
  WEBP
  PNG
  OBJ
  PLY
  STL
  BVH
  FBX
  GLB
  GLTF
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
