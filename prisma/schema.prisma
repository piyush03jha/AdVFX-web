generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================================================
 * PRODUCT
 * ============================================================
 */

model Product {
  id   String @id @default(cuid())
  name String
  slug String @unique

  files ProductFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ============================================================
 * PRODUCT FILE
 * ============================================================
 */

model ProductFile {
  id String @id @default(cuid())

  /**
   * Product
   */
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /**
   * Original uploaded filename
   */
  originalName String

  /**
   * Physical storage identifier
   */
  storageKey String

  /**
   * Optional storage/public URL
   */
  storageUrl String?

  /**
   * File format
   */
  format ProductFileFormat

  /**
   * General file category
   */
  fileType ProductFileType

  /**
   * MIME type
   */
  mimeType String?

  /**
   * File size in bytes
   */
  fileSize BigInt

  /**
   * Processing state
   */
  processingStatus ProcessingStatus @default(PENDING)

  /**
   * Error generated during processing
   */
  processingError String?

  imageWidth      Int?
  imageHeight     Int?
  imageChannels   Int?
  imageHasAlpha   Boolean?
  imageColorSpace String?

  /**
   * If this file was generated from another file.
   * Example:
   * FBX -> GLB
   */
  convertedFromId String?

  convertedFrom ProductFile? @relation("ConvertedFiles", fields: [convertedFromId], references: [id])

  /**
   * Files generated from this file.
   */
  convertedFiles ProductFile[] @relation("ConvertedFiles")

  /**
   * Processing jobs where this file is the source.
   */
  processingJobs ProductFileProcessingJob[]

  /**
   * Processing job that generated this file.
   */
  generatedByJob ProductFileProcessingJob? @relation("ProcessingJobOutput")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([format])
  @@index([processingStatus])
  @@index([convertedFromId])
}

/**
 * ============================================================
 * PRODUCT FILE PROCESSING JOB
 * ============================================================
 * Represents an asynchronous conversion/optimization job.
 * Example:
 * FBX
 * |
 * v
 * Processing Job
 * |
 * v
 * GLB
 */

model ProductFileProcessingJob {
  id String @id @default(cuid())

  /**
   * Source ProductFile
   */
  productFileId String
  productFile   ProductFile @relation(fields: [productFileId], references: [id], onDelete: Cascade)

  /**
   * Job state
   */
  status ProcessingJobStatus @default(QUEUED)

  /**
   * Retry information
   */
  attempts    Int @default(0)
  maxAttempts Int @default(3)

  /**
   * Processing error
   */
  errorMessage String?

  /**
   * Generated output ProductFile.
   * Nullable while the job is running
   * or if processing fails.
   */
  outputFileId String?      @unique
  outputFile   ProductFile? @relation("ProcessingJobOutput", fields: [outputFileId], references: [id], onDelete: SetNull)

  /**
   * Processing timestamps
   */
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productFileId])
  @@index([status])
}

/**
 * ============================================================
 * PRODUCT FILE TYPE
 * ============================================================
 */

enum ProductFileType {
  MODEL
  IMAGE
  DOCUMENT
}

/**
 * ============================================================
 * PRODUCT FILE FORMAT
 * ============================================================
 */

enum ProductFileFormat {
  ABC
  USD
  USDA
  USDC

  SVG
  PDF
  JPG
  WEBP
  PNG

  OBJ
  PLY
  STL
  BVH
  FBX
  GLB
  GLTF
}

/**
 * ============================================================
 * FILE PROCESSING STATUS
 * ============================================================
 */

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/**
 * ============================================================
 * PROCESSING JOB STATUS
 * ============================================================
 */

enum ProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
